# PostgreSQL Database URL (Local Docker or Cloud Neon/Supabase)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/elijah_db?schema=public"

# Node Environment & Port
NODE_ENV="development"
PORT=5000

# JWT Secrets (Must match AUTH_JWT_SECRET in AiService/.env)
JWT_SECRET="super-secret-jwt-key-elijah-ai-2026-very-secure"
JWT_EXPIRES_IN="7d"

# Super Admin Initial Credentials (for seed script)
SUPERADMIN_EMAIL="superadmin@elijah.ai"
SUPERADMIN_PASSWORD="SuperSecretPassword123!"
SUPERADMIN_NAME="Platform SuperAdmin"

# Allowed CORS Origins (Super Admin App & Company App)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Company Frontend URL (used to generate invitation links)
COMPANY_APP_URL="http://localhost:3000"

# Mail Service (SMTP) - Optional for local dev (links print in console & UI modals)
# To send real emails, uncomment and fill in your credentials:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-char-app-password"
# SMTP_FROM='"Elijah AI" <noreply@yourdomain.com>'

# Core Service Internal API Token (Service-to-service auth with AiService)
CORE_SERVICE_TOKEN="replace-with-a-long-random-string"

# Retell AI API Key (from Retell dashboard: https://beta.retellai.com/dashboard)
RETELL_API_KEY="key_your_retell_api_key_here"
