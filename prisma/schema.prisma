datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =========================================================================
// 1. Platform Super Admin (Manages tenants, plans, global settings)
// =========================================================================
model SuperAdmin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("super_admins")
}

// =========================================================================
// 2. Tenant / Company Entity
// =========================================================================
model Tenant {
  id           String        @id @default(cuid())
  name         String        // e.g. "Desert Air HVAC & Plumbing"
  slug         String        @unique // e.g. "desert-air" (used for subdomain / company code)
  tradeType    String        @default("HVAC") // HVAC, PLUMBING, ELECTRICAL, ROOFING, etc.
  phone        String?
  address      String?
  status       TenantStatus  @default(ACTIVE)
  plan         TenantPlan    @default(GROWTH)
  
  // Relations
  users        User[]
  customers    Customer[]
  equipments   Equipment[]
  jobs         Job[]
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([slug])
  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  ARCHIVED
}

enum TenantPlan {
  STARTER
  GROWTH
  OPERATIONS
  ENTERPRISE
}

// =========================================================================
// 3. Dynamic Roles & Permissions System
// =========================================================================
model Permission {
  id          String           @id // Unique permission key e.g. "customers:read"
  name        String           // Human readable label e.g. "View Customers"
  category    String           // Grouping e.g. "Customers", "Dispatch", "Billing"
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model Role {
  id             String           @id @default(cuid())
  name           String           // e.g. "Business Owner", "Office Manager", "Dispatcher"
  slug           String           @unique // e.g. "owner", "office_manager", "dispatcher"
  description    String?
  approvalLimit  Decimal          @default(0) @db.Decimal(14, 2) // Default financial limit ($0 to unlimited)
  
  permissions    RolePermission[]
  users          User[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String
  
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// =========================================================================
// 4. Tenant Users
// =========================================================================
model User {
  id                 String    @id @default(cuid())
  tenantId           String
  email              String
  passwordHash       String
  name               String
  phone              String?
  roleId             String
  isActive           Boolean   @default(true)
  
  // Invitation & Onboarding
  inviteToken        String?   @unique
  inviteExpiresAt    DateTime?
  isInviteAccepted   Boolean   @default(false)
  
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role               Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  jobsAssigned       Job[]     @relation("TechnicianJobs")

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([roleId])
  @@index([inviteToken])
  @@map("users")
}

// =========================================================================
// 5. Tenant Core Data Models (Customers, Equipment, Work Orders)
// =========================================================================
model Customer {
  id           String       @id @default(cuid())
  tenantId     String
  name         String
  customerType String       @default("RESIDENTIAL") // "RESIDENTIAL" | "COMMERCIAL"
  companyName  String?      // Business / Facility name for commercial clients
  phone        String
  email        String?
  address      String?
  city         String?
  state        String?
  zipCode      String?
  gateCode     String?      // Security gate / lockbox code
  accessNotes  String?      // e.g. "Keybox behind meter. Watch for German Shepherd."
  
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  equipments   Equipment[]
  jobs         Job[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([tenantId])
  @@index([phone])
  @@map("customers")
}

model Equipment {
  id             String    @id @default(cuid())
  tenantId       String
  customerId     String
  name           String    // e.g. "Rooftop Packaged Heat Pump 5-Ton"
  type           String    @default("HVAC") // HVAC, WATER_HEATER, ELECTRICAL_PANEL, PLUMBING
  brand          String    // Carrier, Trane, Lennox, Rheem, Square D, etc.
  modelNumber    String?
  serialNumber   String?
  installYear    Int?
  locationOnSite String?   // e.g. "Rooftop - Section B (North ladder)"
  warrantyStatus String    @default("UNDER_WARRANTY") // "UNDER_WARRANTY" | "EXPIRED" | "UNKNOWN"
  notes          String?

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs           Job[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
  @@index([customerId])
  @@index([serialNumber])
  @@map("equipments")
}

model Job {
  id             String     @id @default(cuid())
  tenantId       String
  jobNumber      String?    // e.g. "JOB-9041"
  customerId     String
  equipmentId    String?
  technicianId   String?
  title          String
  status         JobStatus  @default(UNSCHEDULED)
  priority       String     @default("NORMAL") // "EMERGENCY" | "HIGH" | "NORMAL" | "LOW"
  scheduledDate  DateTime?  // Date for calendar
  scheduledStart DateTime?  // Window start
  scheduledEnd   DateTime?  // Window end
  serviceAddress String?
  gateCode       String?
  reportedIssue  String?    // Symptoms reported by customer
  notes          String?    // Tech notes
  totalAmount    Decimal?   @db.Decimal(10, 2)
  
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  equipment      Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  technician     User?      @relation("TechnicianJobs", fields: [technicianId], references: [id], onDelete: SetNull)

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([tenantId])
  @@index([customerId])
  @@index([technicianId])
  @@index([equipmentId])
  @@index([status])
  @@map("jobs")
}

enum JobStatus {
  UNSCHEDULED
  SCHEDULED
  DISPATCHED
  EN_ROUTE
  ON_SITE
  COMPLETED
  CANCELLED
}

